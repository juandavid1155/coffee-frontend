generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  favorites Favorite[]
  cartItems CartItem[]
  orders    Order[]
}

model Product {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  description String
  price       Float
  image       String
  origin      String
  process     String
  createdAt   DateTime  @default(now())
  favorites   Favorite[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model Favorite {
    id        Int     @id @default(autoincrement())
    user      User    @relation(fields: [userId], references: [id])
    userId    Int
    product   Product @relation(fields: [productId], references: [id])
    productId Int
    size      String?
    grind     String?
}

model CartItem {
  id        Int     @id @default(autoincrement())
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  size      String
  grind     String
  quantity  Int
}

model Order {
  id         Int         @id @default(autoincrement())
  user       User        @relation(fields: [userId], references: [id])
  userId     Int
  total      Float
  createdAt  DateTime    @default(now())
  items      OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  size      String
  grind     String
  quantity  Int
  price     Float
}